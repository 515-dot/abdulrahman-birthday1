generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Identity & access ─────────

enum AccountStatus { ACTIVE SUSPENDED DEACTIVATED }
enum DataScope { OWN TEAM DEPARTMENT ALL }

model Department {
  id        String   @id @default(cuid())
  code      String   @unique // SALES, MARKETING, HR, CREATIVE, ADMIN
  nameAr    String
  nameEn    String
  users     User[]
  teams     Team[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  members      User[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  fullName           String
  jobTitle           String?
  status             AccountStatus @default(ACTIVE)
  isSuperAdmin       Boolean       @default(false)
  mustChangePassword Boolean       @default(true)
  dataScope          DataScope     @default(OWN)
  sessionVersion     Int           @default(0) // bump to revoke all sessions
  failedLogins       Int           @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  departmentId       String?
  department         Department?   @relation(fields: [departmentId], references: [id])
  teamId             String?
  team               Team?         @relation(fields: [teamId], references: [id])
  managerId          String?
  manager            User?         @relation("Reports", fields: [managerId], references: [id])
  reports            User[]        @relation("Reports")
  credential         Credential?
  roles              UserRole[]
  permissionGrants   UserPermission[]
  sessions           Session[]
  loginEvents        LoginEvent[]
  leads              Lead[]        @relation("LeadOwner")
  tasks              Task[]
  notifications      Notification[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  @@index([departmentId])
  @@index([managerId])
}

// Authentication data kept in its own table, separate from profile data.
model Credential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   // Argon2id
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of the token; the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([userId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // sales_agent, sales_manager, marketing, hr, designer ...
  nameAr      String
  nameEn      String
  isSystem    Boolean  @default(false)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. leads.view_own
  description String?
  roles       RolePermission[]
  userGrants  UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

// Per-user overrides. granted=false explicitly revokes a role-derived permission.
model UserPermission {
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([userId, permissionId])
}

// ───────── Sales ─────────

model LeadSource {
  id    String @id @default(cuid())
  name  String @unique
  leads Lead[]
}

model PipelineStage {
  id       String @id @default(cuid())
  code     String @unique
  nameAr   String
  nameEn   String
  position Int
  isWon    Boolean @default(false)
  isLost   Boolean @default(false)
  leads    Lead[]
}

model Client {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?
  email       String?
  budgetMin   Decimal? @db.Decimal(14, 2)
  budgetMax   Decimal? @db.Decimal(14, 2)
  preferredLocations String[]
  preferredTypes     String[]
  notes       String?
  ownerId     String?
  leads       Lead[]
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  @@index([phone])
}

model Lead {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?
  email       String?
  sourceId    String?
  source      LeadSource? @relation(fields: [sourceId], references: [id])
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  stageId     String
  stage       PipelineStage @relation(fields: [stageId], references: [id])
  ownerId     String?
  owner       User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  budget      Decimal? @db.Decimal(14, 2)
  notes       String?
  nextFollowUpAt DateTime?
  assignments LeadAssignment[]
  activities  Activity[]
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  @@index([ownerId])
  @@index([stageId])
  @@index([nextFollowUpAt])
}

model LeadAssignment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId String?
  toUserId   String?
  byUserId   String
  createdAt  DateTime @default(now())
  @@index([leadId])
}

enum ActivityType { CALL MEETING WHATSAPP EMAIL NOTE FOLLOW_UP }

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  summary   String
  dueAt     DateTime?
  doneAt    DateTime?
  byUserId  String
  createdAt DateTime     @default(now())
  @@index([leadId])
}

model Task {
  id         String   @id @default(cuid())
  title      String
  assigneeId String
  assignee   User     @relation(fields: [assigneeId], references: [id])
  dueAt      DateTime?
  doneAt     DateTime?
  createdAt  DateTime @default(now())
  @@index([assigneeId])
}

model Developer {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Location {
  id         String     @id @default(cuid())
  name       String
  city       String?
  projects   Project[]
  properties Property[]
}

model PropertyType {
  id         String     @id @default(cuid())
  name       String     @unique
  properties Property[]
}

model Project {
  id          String     @id @default(cuid())
  name        String
  developerId String?
  developer   Developer? @relation(fields: [developerId], references: [id])
  locationId  String?
  location    Location?  @relation(fields: [locationId], references: [id])
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id         String        @id @default(cuid())
  title      String
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id])
  typeId     String?
  type       PropertyType? @relation(fields: [typeId], references: [id])
  locationId String?
  location   Location?     @relation(fields: [locationId], references: [id])
  areaSqm    Decimal?      @db.Decimal(10, 2)
  bedrooms   Int?
  price      Decimal?      @db.Decimal(14, 2)
  status     String        @default("AVAILABLE")
  paymentPlans PaymentPlan[]
  reservations Reservation[]
  deals      Deal[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
}

model PaymentPlan {
  id             String   @id @default(cuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  downPaymentPct Decimal  @db.Decimal(5, 2)
  years          Int
  notes          String?
}

model Deal {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  ownerId     String
  value       Decimal  @db.Decimal(14, 2)
  status      String   @default("OPEN") // OPEN WON LOST
  closedAt    DateTime?
  commission  Commission?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId])
}

model Reservation {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  clientId   String?
  ownerId    String
  amount     Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
}

model Commission {
  id        String   @id @default(cuid())
  dealId    String   @unique
  deal      Deal     @relation(fields: [dealId], references: [id])
  userId    String
  ratePct   Decimal  @db.Decimal(5, 2)
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

// ───────── Marketing ─────────

model Campaign {
  id        String   @id @default(cuid())
  name      String
  channel   String   // facebook, instagram, tiktok, google_ads, other
  budget    Decimal? @db.Decimal(14, 2)
  startsAt  DateTime?
  endsAt    DateTime?
  ownerId   String?
  leads     Lead[]
  expenses  CampaignExpense[]
  content   ContentEntry[]
  briefs    CreativeBrief[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignExpense {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  spentOn    DateTime
  note       String?
}

model ContentEntry {
  id          String   @id @default(cuid())
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  platform    String
  caption     String?
  publishAt   DateTime?
  status      String   @default("DRAFT") // DRAFT IN_REVIEW APPROVED PUBLISHED
  createdAt   DateTime @default(now())
}

// ───────── Creative ─────────

model CreativeProject {
  id         String   @id @default(cuid())
  title      String
  status     String   @default("BRIEF_RECEIVED")
  priority   String   @default("NORMAL")
  dueAt      DateTime?
  assigneeId String?
  createdById String
  brief      CreativeBrief?
  assets     CreativeAsset[]
  approvals  ApprovalRequest[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([assigneeId])
}

model CreativeBrief {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  body       String
}

model CreativeAsset {
  id        String   @id @default(cuid())
  projectId String
  project   CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  versions  AssetVersion[]
}

model AssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  asset     CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version   Int
  storageKey String
  uploadedById String
  createdAt DateTime @default(now())
  @@unique([assetId, version])
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  projectId   String
  project     CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById String
  decidedById String?
  decision    String?  // APPROVED | REVISIONS_REQUIRED
  comment     String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
}

// ───────── HR (sensitive; salary kept in a separate table) ─────────

model EmployeeProfile {
  userId       String   @id
  nationalId   String?
  phone        String?
  joinedAt     DateTime?
  probationEndsAt DateTime?
  employmentStatus String @default("ACTIVE")
  updatedAt    DateTime @updatedAt
}

model SalaryRecord {
  id         String   @id @default(cuid())
  userId     String
  baseSalary Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  createdAt  DateTime @default(now())
  @@index([userId])
}

model PayrollRecord {
  id         String   @id @default(cuid())
  userId     String
  period     String   // YYYY-MM
  gross      Decimal  @db.Decimal(12, 2)
  bonuses    Decimal  @default(0) @db.Decimal(12, 2)
  deductions Decimal  @default(0) @db.Decimal(12, 2)
  net        Decimal  @db.Decimal(12, 2)
  @@unique([userId, period])
}

model AttendanceRecord {
  id       String   @id @default(cuid())
  userId   String
  checkIn  DateTime
  checkOut DateTime?
  @@index([userId, checkIn])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  startsOn  DateTime
  endsOn    DateTime
  reason    String?
  status    String   @default("PENDING") // PENDING APPROVED REJECTED
  decidedById String?
  createdAt DateTime @default(now())
  @@index([userId])
}

model Candidate {
  id        String   @id @default(cuid())
  fullName  String
  position  String
  stage     String   @default("APPLIED")
  notes     String?
  createdAt DateTime @default(now())
}

// ───────── Platform ─────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   // never include salary or personal HR data here
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}

model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  promptTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // e.g. auth.login_failed, user.suspended, role.permission_changed
  targetType String?
  targetId   String?
  metadata   Json?    // must never contain secrets
  ip         String?
  createdAt  DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
