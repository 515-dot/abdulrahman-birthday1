# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/geography_crm"

# Session signing secret: generate with `openssl rand -base64 48`
SESSION_SECRET=""

# One-time Super Admin bootstrap (used only by `npm run setup:admin`).
# Choose your own values; the account is forced to change the password at first login.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Optional: AI provider (server-side only). If empty, AI screens show a setup state.
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""   # model ID from your provider's documentation

# Optional integrations (inactive until configured and tested)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_SECRET=""
SMTP_URL=""
